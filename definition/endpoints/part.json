{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "part",
  "display_name": "Parts (Products)",
  "description": "Products and articles offered or stocked in sevdesk.",
  "operations": {
    "read": {
      "params": {
        "partNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all parts with this part number."
        },
        "name": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all parts with this name."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size. sevdesk accepts 1..1000 and returns HTTP 400 outside that range."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Record offset into the result set."
        }
      },
      "request": {
        "method": "GET",
        "path": "/Part",
        "query": {
          "partNumber": {
            "from_param": "partNumber"
          },
          "name": {
            "from_param": "name"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "description": "sevdesk wraps every list response in an `objects` array.",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "native_type": "integer",
                    "arrow_type": "Int64",
                    "description": "The part id. The sevdesk spec declares Model_Part.id as `integer`, unlike almost every sibling model whose `id` is `string`."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The part object name, 'Part'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of part creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last part update. Not usable as a replication cursor: sevdesk documents no `updateAfter` filter on /Part."
                  },
                  "name": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the part."
                  },
                  "partNumber": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The part number. sevdesk's documented natural key for a part."
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "A text describing the part."
                  },
                  "category": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Category of the part, as a sevdesk relation ({ id, objectName: 'Category' }). For all categories, send a GET to /Category?objectType=Part."
                  },
                  "stock": {
                    "type": "number",
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "The stock of the part."
                  },
                  "stockEnabled": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines if the stock should be enabled. sevdesk returns this as the string '0'/'1' on the read path even though its OpenAPI model declares type: boolean — the spec's own example for this field is a quoted string. Typed Utf8 so the value survives; the write path still takes a real boolean."
                  },
                  "unity": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The unit in which the part is measured, as a sevdesk relation ({ id, objectName: 'Unity' })."
                  },
                  "price": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "Net price for which the part is sold. sevdesk plans to change this parameter so that the gross price is calculated automatically; until then priceGross must be used."
                  },
                  "priceNet": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "Net price for which the part is sold."
                  },
                  "priceGross": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "Gross price for which the part is sold."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the part belongs, as a sevdesk relation ({ id, objectName: 'SevClient' }). Filled automatically."
                  },
                  "pricePurchase": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "Purchase price of the part."
                  },
                  "taxRate": {
                    "type": "number",
                    "native_type": "number",
                    "arrow_type": "Float64",
                    "description": "Tax rate of the part."
                  },
                  "status": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "native_type": "integer",
                    "arrow_type": "Int64",
                    "description": "Status of the part: 50 = Inactive, 100 = Active."
                  },
                  "internalComment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "An internal comment for the part. Does not appear on invoices and orders."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/Part",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "description": "One part to create. POST /Part takes the part object bare (no envelope) and answers 201 with the created Model_Part, also bare.",
            "properties": {
              "id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The part id. Server-assigned on insert."
              },
              "objectName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The part object name. Must be 'Part'."
              },
              "create": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of part creation."
              },
              "update": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of last part update."
              },
              "name": {
                "type": "string",
                "description": "Name of the part."
              },
              "partNumber": {
                "type": "string",
                "description": "The part number."
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A text describing the part."
              },
              "category": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Category of the part. sevdesk relation: { id: <category id>, objectName: 'Category' }. For all categories, send a GET to /Category?objectType=Part."
              },
              "stock": {
                "type": "number",
                "description": "The stock of the part."
              },
              "stockEnabled": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Defines if the stock should be enabled."
              },
              "unity": {
                "type": "object",
                "description": "The unit in which the part is measured. sevdesk relation: { id: <unity id>, objectName: 'Unity' }."
              },
              "price": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Net price for which the part is sold."
              },
              "priceNet": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Net price for which the part is sold."
              },
              "priceGross": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Gross price for which the part is sold."
              },
              "sevClient": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Client to which the part belongs. sevdesk relation: { id: <client id>, objectName: 'SevClient' }. Filled automatically."
              },
              "pricePurchase": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Purchase price of the part."
              },
              "taxRate": {
                "type": "number",
                "description": "Tax rate of the part."
              },
              "status": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Status of the part: 50 = Inactive, 100 = Active."
              },
              "internalComment": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "An internal comment for the part. Does not appear on invoices and orders."
              }
            },
            "required": [
              "name",
              "partNumber",
              "stock",
              "unity",
              "taxRate"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      },
      "upsert": {
        "request": {
          "method": "PUT",
          "path": "/Part/{part_id}",
          "path_params": {
            "part_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "description": "One part to update. PUT /Part/{partId} takes the part object bare and answers 200 with the updated Model_Part, also bare. `id` supplies the {partId} URL segment; `partNumber` is the natural key the upsert matches on.",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The part id. Supplies the {partId} path segment."
              },
              "objectName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The part object name. Must be 'Part'."
              },
              "create": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of part creation."
              },
              "update": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of last part update."
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the part."
              },
              "partNumber": {
                "type": "string",
                "description": "The part number. sevdesk's documented natural key for a part; the conflict key for this mode."
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A text describing the part."
              },
              "category": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Category of the part. sevdesk relation: { id: <category id>, objectName: 'Category' }."
              },
              "stock": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "The stock of the part."
              },
              "stockEnabled": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Defines if the stock should be enabled."
              },
              "unity": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The unit in which the part is measured. sevdesk relation: { id: <unity id>, objectName: 'Unity' }."
              },
              "price": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Net price for which the part is sold."
              },
              "priceNet": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Net price for which the part is sold."
              },
              "priceGross": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Gross price for which the part is sold."
              },
              "sevClient": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Client to which the part belongs. sevdesk relation: { id: <client id>, objectName: 'SevClient' }."
              },
              "pricePurchase": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Purchase price of the part."
              },
              "taxRate": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Tax rate of the part."
              },
              "status": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Status of the part: 50 = Inactive, 100 = Active."
              },
              "internalComment": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "An internal comment for the part. Does not appear on invoices and orders."
              }
            },
            "required": [
              "id",
              "partNumber"
            ]
          }
        },
        "conflict_keys": [
          "partNumber"
        ],
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}
