{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "part",
  "display_name": "Part (Inventory)",
  "description": "Parts (products/articles) with stock levels, sales and purchase prices, tax rate and category assignment.",
  "operations": {
    "read": {
      "params": {
        "partNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Filter by part number (the documented natural-key lookup filter)."
        },
        "name": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Filter by part name."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/Part",
        "query": {
          "partNumber": { "from_param": "partNumber" },
          "name": { "from_param": "name" },
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "limit": {
          "param": "limit",
          "default": { "ref": "runtime.batch_size" },
          "max": 1000
        },
        "stop_when": {
          "empty": { "ref": "response.body.objects" }
        }
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "native_type": "integer",
                    "arrow_type": "Int32",
                    "description": "sevdesk id of the part."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": ["Part"],
                    "description": "Model name; always 'Part'."
                  },
                  "create": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Creation timestamp (system-set); wire samples carry a UTC offset (e.g. 2024-06-28T14:42:58+02:00)."
                  },
                  "update": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Last-modification timestamp (system-set); wire samples carry a UTC offset."
                  },
                  "name": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the part."
                  },
                  "partNumber": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Part number; the documented lookup key for this resource."
                  },
                  "text": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Free-text description of the part."
                  },
                  "category": {
                    "type": ["object", "null"],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Category relation ({id, objectName='Category'})."
                  },
                  "stock": {
                    "type": "number",
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Current stock amount."
                  },
                  "stockEnabled": {
                    "type": "boolean",
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether stock tracking is enabled for the part (spec examples show it as 1/0)."
                  },
                  "unity": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Unity relation ({id, objectName='Unity'}) — the unit the part is measured in."
                  },
                  "price": {
                    "type": ["number", "null"],
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Price the part is sold for; gross or net depending on the account setting."
                  },
                  "priceNet": {
                    "type": ["number", "null"],
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Net sales price."
                  },
                  "priceGross": {
                    "type": ["number", "null"],
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Gross sales price; must be supplied until gross auto-calculation ships."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "SevClient relation the part belongs to ({id, objectName='SevClient'})."
                  },
                  "pricePurchase": {
                    "type": ["number", "null"],
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Purchase price of the part."
                  },
                  "taxRate": {
                    "type": "number",
                    "native_type": "double",
                    "arrow_type": "Float64",
                    "description": "Tax rate of the part. Under sevdesk-Update 2.0 part creation is restricted to 0.0, 7.0 or 19.0."
                  },
                  "status": {
                    "type": ["integer", "null"],
                    "native_type": "integer",
                    "arrow_type": "Int32",
                    "enum": [50, 100, null],
                    "description": "50 = Inactive, 100 = Active."
                  },
                  "internalComment": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Internal comment; does not appear on invoices or orders."
                  }
                },
                "required": ["id", "objectName"]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/Part",
          "headers": { "Content-Type": "application/json" },
          "body": { "from_input": "record" }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Name of the part." },
              "partNumber": { "type": "string", "description": "Part number." },
              "text": { "type": "string", "description": "Free-text description of the part." },
              "category": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Category" }
                },
                "description": "Category relation."
              },
              "stock": { "type": "number", "description": "Initial stock amount." },
              "stockEnabled": { "type": "boolean", "description": "Whether stock tracking is enabled." },
              "unity": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Unity" }
                },
                "description": "Unity relation — the unit the part is measured in."
              },
              "price": { "type": "number", "description": "Sales price; gross or net depending on the account setting." },
              "priceNet": { "type": "number", "description": "Net sales price." },
              "priceGross": { "type": "number", "description": "Gross sales price; must be supplied until gross auto-calculation ships." },
              "pricePurchase": { "type": "number", "description": "Purchase price." },
              "taxRate": { "type": "number", "description": "Tax rate. Under sevdesk-Update 2.0 creation is restricted to 0.0, 7.0 or 19.0." },
              "status": { "type": "integer", "enum": [50, 100], "description": "50 = Inactive, 100 = Active." },
              "internalComment": { "type": "string", "description": "Internal comment." }
            },
            "required": ["name", "partNumber", "stock", "unity", "taxRate"]
          }
        },
        "response": {
          "generated_keys": { "ref": "response.body.objects.id" }
        }
      },
      "upsert": {
        "conflict_keys": ["partNumber"],
        "request": {
          "method": "PUT",
          "path": "/Part/{part_id}",
          "path_params": {
            "part_id": { "from_input": "record.id" }
          },
          "headers": { "Content-Type": "application/json" },
          "body": { "from_input": "record" }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "description": "sevdesk id of the part to update; supplies the {partId} path segment." },
              "name": { "type": "string", "description": "Name of the part." },
              "partNumber": { "type": "string", "description": "Part number — the conflict key this upsert matches on." },
              "text": { "type": "string", "description": "Free-text description of the part." },
              "category": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Category" }
                },
                "description": "Category relation."
              },
              "stock": { "type": "number", "description": "Stock amount." },
              "stockEnabled": { "type": "boolean", "description": "Whether stock tracking is enabled." },
              "unity": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Unity" }
                },
                "description": "Unity relation — the unit the part is measured in."
              },
              "price": { "type": "number", "description": "Sales price; gross or net depending on the account setting." },
              "priceNet": { "type": "number", "description": "Net sales price." },
              "priceGross": { "type": "number", "description": "Gross sales price." },
              "pricePurchase": { "type": "number", "description": "Purchase price." },
              "taxRate": { "type": "number", "description": "Tax rate of the part." },
              "status": { "type": "integer", "enum": [50, 100], "description": "50 = Inactive, 100 = Active." },
              "internalComment": { "type": "string", "description": "Internal comment." }
            },
            "required": ["id", "partNumber"]
          }
        },
        "response": {
          "generated_keys": { "ref": "response.body.objects.id" }
        }
      }
    }
  }
}
