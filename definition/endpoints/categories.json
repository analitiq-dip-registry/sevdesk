{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "display_name": "Categories",
  "description": "Categories used to classify contacts and other resources.",
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "/Category",
        "query": {
          "objectType": {
            "from_param": "objectType"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "params": {
        "objectType": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Filter by object type."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "create": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Create timestamp."
                  },
                  "update": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Last update timestamp."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "sevdesk client.",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "objectName": {
                        "type": "string"
                      }
                    }
                  },
                  "name": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "objectType": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Type the category applies to (Contact, Invoice, etc.)."
                  },
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "translationCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/Category",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "name": {
              "from_input": "name"
            },
            "objectType": {
              "from_input": "objectType"
            },
            "code": {
              "from_input": "code"
            }
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "objectType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "objectType"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.objects.id"
          }
        }
      },
      "upsert": {
        "conflict_keys": [
          "id"
        ],
        "request": {
          "method": "PUT",
          "path": "/Category/{categoryId}",
          "path_params": {
            "categoryId": {
              "from_input": "id"
            }
          },
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "name": {
              "from_input": "name"
            },
            "objectType": {
              "from_input": "objectType"
            },
            "code": {
              "from_input": "code"
            }
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "objectType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.objects.id"
          }
        }
      }
    }
  },
  "endpoint_id": "categories"
}
