{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "display_name": "Tag Relations",
  "description": "Many-to-many associations between tags and other resources.",
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "/TagRelation",
        "query": {
          "tag[id]": {
            "from_param": "tag[id]"
          },
          "tag[objectName]": {
            "from_param": "tag[objectName]"
          },
          "object[objectName]": {
            "from_param": "object[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "params": {
        "tag[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Filter by tag[id]."
        },
        "tag[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Use 'Tag'."
        },
        "object[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Tagged object type."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "create": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Create timestamp."
                  },
                  "update": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Last update timestamp."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "sevdesk client."
                  },
                  "tag": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json"
                  },
                  "object": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The tagged object (any sevdesk resource)."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/TagRelation",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "tag": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "id",
                  "objectName"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "objectName": {
                    "type": "string",
                    "const": "Tag"
                  }
                }
              },
              "object": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "tag",
              "object"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.objects.id"
          }
        }
      }
    }
  },
  "endpoint_id": "tagrelation"
}
