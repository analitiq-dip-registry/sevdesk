{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "contactaddress",
  "display_name": "Contact Addresses",
  "description": "Postal addresses associated with contacts.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/ContactAddress",
        "query": {
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "native_type": "integer",
                    "arrow_type": "Int64",
                    "description": "The contact address id. NOTE: sevdesk declares this integer here while most sibling resources declare a string id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The contact address object name ('ContactAddress')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of contact address creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last contact address update."
                  },
                  "contact": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The contact to which this contact address belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"Contact\"}."
                  },
                  "street": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Street name."
                  },
                  "zip": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Zip code."
                  },
                  "city": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "City name."
                  },
                  "country": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Country of the contact address. sevdesk relation of the form {\"id\": ..., \"objectName\": \"StaticCountry\"}; for all countries send a GET to /StaticCountry."
                  },
                  "category": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Category of the contact address. sevdesk relation of the form {\"id\": ..., \"objectName\": \"Category\"}; for all categories send a GET to /Category?objectType=ContactAddress."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name in address."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the contact address belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"SevClient\"}; filled automatically."
                  },
                  "name2": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Second name in address."
                  },
                  "name3": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Third name in address."
                  },
                  "name4": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Fourth name in address."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
