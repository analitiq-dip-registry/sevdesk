                  "null"
                ],
                "description": "Name in address."
              },
              "name2": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Second name in address."
              },
              "name3": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Third name in address."
              },
              "name4": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fourth name in address."
              }
            },
            "required": [
