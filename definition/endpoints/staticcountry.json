{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "staticcountry",
  "display_name": "Static Countries",
  "description": "Reference data: the country list a contact address can reference. Read-only. Provenance: /StaticCountry has NO entry in the sevdesk OpenAPI `paths:` object; the route is grounded verbatim in a first-party field description inside components.schemas — 'Country of the contact address. For all countries, send a GET to /StaticCountry'. The response field list is not published anywhere in the spec and is carried forward verbatim from the released 3.0.1 endpoint document.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size. sevdesk accepts 1..1000 and returns HTTP 400 outside that range."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Record offset into the result set."
        }
      },
      "request": {
        "method": "GET",
        "path": "/StaticCountry",
        "query": {
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "description": "sevdesk wraps every list response in an `objects` array.",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "Record shape is NOT published in the sevdesk OpenAPI document; carried forward verbatim from the released 3.0.1 definition.",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The country id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Object name, which is 'StaticCountry'."
                  },
                  "code": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Country code."
                  },
                  "nameEn": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "English name of the country."
                  },
                  "translationCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Translation code of the country."
                  },
                  "priority": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "native_type": "integer",
                    "arrow_type": "Int64",
                    "description": "Display priority of the country."
                  }
                },
                "required": [
                  "id",
                  "objectName",
                  "code"
                ]
              }
            }
          }
        }
      }
    }
  }
}