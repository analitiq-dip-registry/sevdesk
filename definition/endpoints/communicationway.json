{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "communicationway",
  "display_name": "Communication Ways",
  "description": "Phone, email, web, and mobile communication channels for contacts.",
  "operations": {
    "read": {
      "params": {
        "contact[id]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "ID of the contact for which you want the communication ways."
        },
        "contact[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Object name. Only needed if you also defined the ID of a contact; use 'Contact'."
        },
        "type": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Type of the communication ways you want to get. One of PHONE, EMAIL, WEB, MOBILE."
        },
        "main": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Define if you only want the main communication way. One of '0', '1'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/CommunicationWay",
        "query": {
          "contact[id]": {
            "from_param": "contact[id]"
          },
          "contact[objectName]": {
            "from_param": "contact[objectName]"
          },
          "type": {
            "from_param": "type"
          },
          "main": {
            "from_param": "main"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The communication way id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The communication way object name ('CommunicationWay')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of communication way creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last communication way update."
                  },
                  "contact": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The contact to which this communication way belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"Contact\"}."
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "EMAIL",
                      "PHONE",
                      "WEB",
                      "MOBILE",
                      null
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Type of the communication way."
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The value of the communication way, e.g. the phone number, e-mail address or website."
                  },
                  "key": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The key of the communication way, similar to the category of addresses. sevdesk relation of the form {\"id\": ..., \"objectName\": \"CommunicationWayKey\"}; for all keys send a GET to /CommunicationWayKey."
                  },
                  "main": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Whether the communication way is the main communication way for the contact. sevdesk returns this as a string ('0'/'1') while the request body declares it boolean."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the communication way belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"SevClient\"}; filled automatically."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/CommunicationWay",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "contact": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The contact to which this communication way belongs. sevdesk relation: {\"id\": <contact id>, \"objectName\": \"Contact\"}."
              },
              "type": {
                "type": "string",
                "enum": [
                  "EMAIL",
                  "PHONE",
                  "WEB",
                  "MOBILE"
                ],
                "description": "Type of the communication way."
              },
              "value": {
                "type": "string",
                "description": "The value of the communication way, e.g. the phone number, e-mail address or website."
              },
              "key": {
                "type": "object",
                "description": "The key of the communication way. sevdesk relation: {\"id\": <key id>, \"objectName\": \"CommunicationWayKey\"}."
              },
              "main": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether the communication way is the main communication way for the contact."
              }
            },
            "required": [
              "type",
              "value",
              "key"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      },
      "upsert": {
        "request": {
          "method": "PUT",
          "path": "/CommunicationWay/{communication_way_id}",
          "path_params": {
            "communication_way_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The communication way id; supplies the {communicationWayId} path segment."
              },
              "contact": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The contact to which this communication way belongs. sevdesk relation: {\"id\": <contact id>, \"objectName\": \"Contact\"}."
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "EMAIL",
                  "PHONE",
                  "WEB",
                  "MOBILE",
                  null
                ],
                "description": "Type of the communication way."
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The value of the communication way, e.g. the phone number, e-mail address or website."
              },
              "key": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The key of the communication way. sevdesk relation: {\"id\": <key id>, \"objectName\": \"CommunicationWayKey\"}."
              },
              "main": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether the communication way is the main communication way for the contact."
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "conflict_keys": [
          "id"
        ],
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}