{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "order",
  "display_name": "Orders",
  "description": "sevdesk orders — quotations (AN), order confirmations (AB) and delivery notes (LI).",
  "operations": {
    "read": {
      "params": {
        "status": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Status of the order. One of 100, 200, 300, 500, 750, 1000."
        },
        "orderNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all orders with this order number."
        },
        "startDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "gte"
          ],
          "description": "Retrieve all orders with an order date equal or higher, as epoch seconds. Windows the document date, not the modification time."
        },
        "endDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "lte"
          ],
          "description": "Retrieve all orders with an order date equal or lower, as epoch seconds. Windows the document date, not the modification time."
        },
        "contact[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all orders with this contact. Must be provided together with contact[objectName]."
        },
        "contact[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if contact[id] was provided. 'Contact' should be used as value."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/Order",
        "query": {
          "status": {
            "from_param": "status"
          },
          "orderNumber": {
            "from_param": "orderNumber"
          },
          "startDate": {
            "from_param": "startDate"
          },
          "endDate": {
            "from_param": "endDate"
          },
          "contact[id]": {
            "from_param": "contact[id]"
          },
          "contact[objectName]": {
            "from_param": "contact[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "objectName"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The order id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The order object name."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of order creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last order update."
                  },
                  "orderNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The order number."
                  },
                  "contact": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The contact used in the order. sevdesk relation shaped {\"id\": ..., \"objectName\": \"Contact\"}."
                  },
                  "orderDate": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Order date."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "100",
                      "200",
                      "300",
                      "500",
                      "750",
                      "1000"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Status code of the order. See the sevdesk 'status of orders' table for the meaning of each code."
                  },
                  "header": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Header, normally the prefix plus the order number."
                  },
                  "headText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Head text. Certain HTML tags can be used to format it."
                  },
                  "footText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Foot text. Certain HTML tags can be used to format it."
                  },
                  "addressCountry": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Country of the address. sevdesk relation shaped {\"id\": ..., \"objectName\": \"StaticCountry\"}."
                  },
                  "createUser": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "User who created the order; filled automatically. sevdesk relation shaped {\"id\": ..., \"objectName\": \"SevUser\"}."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the order belongs; filled automatically. sevdesk relation shaped {\"id\": ..., \"objectName\": \"SevClient\"}."
                  },
                  "deliveryTerms": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Delivery terms of the order."
                  },
                  "paymentTerms": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Payment terms of the order."
                  },
                  "origin": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Object from which the order was created, for example an offer. sevdesk relation shaped {\"id\": ..., \"objectName\": \"Order\"}."
                  },
                  "version": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Version of the order; useful when multiple drafts exist for the same order. Starts at 0."
                  },
                  "smallSettlement": {
                    "type": "boolean",
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether the client uses the small settlement scheme. If so, the order must not contain any VAT."
                  },
                  "contactPerson": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The user who acts as a contact person for the order. sevdesk relation shaped {\"id\": ..., \"objectName\": \"SevUser\"}."
                  },
                  "taxRate": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Not used anymore. Use the taxRate of the individual positions instead."
                  },
                  "taxRule": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "VAT rule (sevdesk-Update 2.0, replaces taxType/taxSet). sevdesk relation shaped {\"id\": ..., \"objectName\": \"TaxRule\"}."
                  },
                  "taxSet": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Tax set of the order (sevdesk-Update 1.0). sevdesk relation shaped {\"id\": ..., \"objectName\": \"TaxSet\"}."
                  },
                  "taxText": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax text, for example 'Umsatzsteuer 19%'."
                  },
                  "taxType": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax type of the order (sevdesk-Update 1.0): default, eu, noteu, custom."
                  },
                  "orderType": {
                    "type": "string",
                    "enum": [
                      "AN",
                      "AB",
                      "LI"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Type of the order: AN (quotation), AB (order confirmation), LI (delivery note)."
                  },
                  "sendDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "The date the order was sent to the customer."
                  },
                  "address": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Complete address of the recipient including name, street, city, zip and country. May contain line breaks."
                  },
                  "currency": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Currency used in the order, as an ISO-4217 currency code."
                  },
                  "sumNet": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net sum of the order. Returned as a string by the API."
                  },
                  "sumTax": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax sum of the order. Returned as a string by the API."
                  },
                  "sumGross": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross sum of the order. Returned as a string by the API."
                  },
                  "sumDiscounts": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Sum of all discounts in the order. Returned as a string by the API."
                  },
                  "sumNetForeignCurrency": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net sum of the order in the foreign currency. Returned as a string by the API."
                  },
                  "sumTaxForeignCurrency": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax sum of the order in the foreign currency. Returned as a string by the API."
                  },
                  "sumGrossForeignCurrency": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross sum of the order in the foreign currency. Returned as a string by the API."
                  },
                  "sumDiscountsForeignCurrency": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discounts sum of the order in the foreign currency. Returned as a string by the API."
                  },
                  "customerInternalNote": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Internal note of the customer. Contains data entered into the field 'Referenz/Bestellnummer'."
                  },
                  "showNet": {
                    "type": "boolean",
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "If true, the net amount of each position is shown on the order; otherwise the gross amount."
                  },
                  "sendType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Type which was used to send the order: VPR, VPDF, VM or VP."
                  }
                }
              }
            }
          }
        }
      }
    },
