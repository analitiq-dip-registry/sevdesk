                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "The creditNote position id. Send it to update an existing position."
                    },
                    "objectName": {
                      "type": "string",
                      "description": "The creditNote position object name. Must always be 'CreditNotePos'."
                    },
                    "mapAll": {
                      "type": "boolean",
