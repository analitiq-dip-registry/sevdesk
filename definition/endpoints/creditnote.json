                "required": [
                  "objectName",
                  "mapAll",
                  "creditNoteNumber",
                  "contact",
                  "creditNoteDate",
                  "status",
                  "header",
                  "addressCountry",
                  "contactPerson",
                  "taxRule",
                  "taxRate",
                  "taxText",
                  "taxType",
                  "bookingCategory",
                  "currency"
                ]
              },
              "creditNotePosSave": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "Credit note positions to create or update together with the credit note.",
