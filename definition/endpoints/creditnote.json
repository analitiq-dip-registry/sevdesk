{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "creditnote",
  "display_name": "Credit Notes",
  "description": "Credit notes (Gutschriften) issued to customers. Read is the paginated /CreditNote collection; writes go through the saveCreditNote factory (insert) and PUT /CreditNote/{creditNoteId} (upsert).",
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "/CreditNote",
        "query": {
          "status": {
            "from_param": "status"
          },
          "creditNoteNumber": {
            "from_param": "creditNoteNumber"
          },
          "startDate": {
            "from_param": "startDate"
          },
          "endDate": {
            "from_param": "endDate"
          },
          "contact[id]": {
            "from_param": "contact[id]"
          },
          "contact[objectName]": {
            "from_param": "contact[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "params": {
        "status": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Status of the credit note: 100 (draft), 200 (open), 300, 500, 750, 1000."
        },
        "creditNoteNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all credit notes with this credit note number."
        },
        "startDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "gte"
          ],
          "description": "Lower bound on the credit note DOCUMENT date (creditNoteDate), as a Unix timestamp in seconds. Not a modification-time filter."
        },
        "endDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "lte"
          ],
          "description": "Upper bound on the credit note DOCUMENT date (creditNoteDate), as a Unix timestamp in seconds. Not a modification-time filter."
        },
        "contact[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all credit notes for this contact. Must be sent together with contact[objectName]."
        },
        "contact[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if contact[id] was provided. Use the value 'Contact'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Number of records per page. sevdesk accepts 1..1000."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Number of records to skip. Counts records, not pages."
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The creditNote id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The creditNote object name ('CreditNote')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of creditNote creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last creditNote update."
                  },
                  "creditNoteNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The creditNote number."
                  },
                  "contact": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The contact used in the creditNote. Relation {id, objectName: 'Contact'}."
                  },
                  "creditNoteDate": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "The credit note document date."
                  },
                  "status": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Status of the credit note: 100 (draft), 200 (open), 750 (partially paid), 1000 (paid)."
                  },
                  "header": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Normally consists of prefix plus the creditNote number."
                  },
                  "headText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Head text. May contain HTML formatting."
                  },
                  "footText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Foot text. May contain HTML formatting."
                  },
                  "addressCountry": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Country of the recipient address. Relation {id, objectName: 'StaticCountry'}."
                  },
                  "createUser": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "User who created the creditNote. Filled automatically. Relation {id, objectName: 'SevUser'}."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client the creditNote belongs to. Filled automatically. Relation {id, objectName: 'SevClient'}."
                  },
                  "deliveryDate": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Delivery date. Can be the start of a range when deliveryDateUntil is used."
                  },
                  "smallSettlement": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Whether the client uses the small settlement scheme. If so, the creditNote must not contain any VAT. sevdesk returns this as the string '0'/'1' on the read path even though its OpenAPI model declares type: boolean — the spec's own example for this field is a quoted string. Typed Utf8 so the value survives; the write path still takes a real boolean."
                  },
                  "contactPerson": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The user acting as contact person for the creditNote. Relation {id, objectName: 'SevUser'}."
                  },
                  "taxRate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Deprecated document-level tax rate. Use the taxRate of the individual positions instead."
                  },
                  "taxRule": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "VAT rule (sevdesk-Update 2.0, replaces taxType/taxSet). Relation {id, objectName: 'TaxRule'}."
                  },
                  "taxSet": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Tax set (sevdesk-Update 1.0). Relation {id, objectName: 'TaxSet'}."
                  },
                  "taxText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax text, e.g. 'Umsatzsteuer 19%'."
                  },
                  "taxType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax type (sevdesk-Update 1.0): default, eu, noteu, custom, ss."
                  },
                  "sendDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date the creditNote was sent to the customer."
                  },
                  "address": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Complete recipient address including name, street, city, zip and country. May contain line breaks."
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "ISO-4217 currency code used in the creditNote."
                  },
                  "sumNet": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net sum of the creditNote. Returned as a decimal string."
                  },
                  "sumTax": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax sum of the creditNote. Returned as a decimal string."
                  },
                  "sumGross": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross sum of the creditNote. Returned as a decimal string."
                  },
                  "sumDiscounts": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Sum of all discounts in the creditNote. Returned as a decimal string."
                  },
                  "sumNetForeignCurrency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net sum in the foreign currency. Returned as a decimal string."
                  },
                  "sumTaxForeignCurrency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax sum in the foreign currency. Returned as a decimal string."
                  },
                  "sumGrossForeignCurrency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross sum in the foreign currency. Returned as a decimal string."
                  },
                  "sumDiscountsForeignCurrency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discounts sum in the foreign currency. Returned as a decimal string."
                  },
                  "customerInternalNote": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Internal note of the customer (field 'Referenz/Bestellnummer')."
                  },
                  "showNet": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "If true, the net amount of each position is shown on the creditNote, otherwise the gross amount. sevdesk returns this as the string '0'/'1' on the read path even though its OpenAPI model declares type: boolean — the spec's own example for this field is a quoted string. Typed Utf8 so the value survives; the write path still takes a real boolean."
                  },
                  "sendType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Type used to send the creditNote: VPR, VPDF, VM or VP."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/CreditNote/Factory/saveCreditNote",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "description": "One saveCreditNote factory payload: the credit note plus the positions and discounts saved or deleted with it.",
            "properties": {
              "creditNote": {
                "type": "object",
                "description": "The credit note model.",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "The creditNote id. Required only when creating/updating a position for an existing credit note."
                  },
                  "objectName": {
                    "type": "string",
                    "description": "The creditNote object name. Must always be 'CreditNote'."
                  },
                  "mapAll": {
                    "type": "boolean",
                    "description": "sevdesk internal flag. Must always be sent as true."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Date of creditNote creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Date of last creditNote update."
                  },
                  "creditNoteNumber": {
                    "type": "string",
                    "description": "The creditNote number."
                  },
                  "contact": {
                    "type": "object",
                    "description": "The contact used in the creditNote. Relation {id, objectName: 'Contact'}."
                  },
                  "creditNoteDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Credit note document date. sevdesk accepts a timestamp or dd.mm.yyyy."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "100",
                      "200",
                      "300",
                      "500",
                      "750",
                      "1000"
                    ],
                    "description": "Status of the credit note."
                  },
                  "header": {
                    "type": "string",
                    "description": "Normally consists of prefix plus the creditNote number."
                  },
                  "headText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Head text. May contain HTML formatting."
                  },
                  "footText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Foot text. May contain HTML formatting."
                  },
                  "addressCountry": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Country of the recipient address. Relation {id, objectName: 'StaticCountry'}. May be null when the complete address is given in 'address'."
                  },
                  "createUser": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Filled automatically by sevdesk and cannot be changed. Relation {id, objectName: 'SevUser'}."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Filled automatically by sevdesk. Relation {id, objectName: 'SevClient'}."
                  },
                  "smallSettlement": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Whether the client uses the small settlement scheme. If so, the creditNote must not contain any VAT."
                  },
                  "contactPerson": {
                    "type": "object",
                    "description": "The user acting as contact person for the creditNote. Relation {id, objectName: 'SevUser'}."
                  },
                  "taxRule": {
                    "type": "object",
                    "description": "VAT rule (sevdesk-Update 2.0, replaces taxType/taxSet). Relation {id, objectName: 'TaxRule'}."
                  },
                  "taxRate": {
                    "type": "number",
                    "description": "Deprecated document-level tax rate. Use the taxRate of the individual positions instead."
                  },
                  "taxSet": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Tax set (sevdesk-Update 1.0), needed for tax type 'custom'. Relation {id, objectName: 'TaxSet'}."
                  },
                  "taxText": {
                    "type": "string",
                    "description": "Tax text, e.g. 'Umsatzsteuer 19%'."
                  },
                  "taxType": {
                    "type": "string",
                    "description": "Tax type (sevdesk-Update 1.0): default, eu, noteu, custom, ss. Declared required by the provider even under Update 2.0, where taxRule supersedes it."
                  },
                  "sendDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Date the creditNote was sent to the customer."
                  },
                  "address": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Complete recipient address including name, street, city, zip and country."
                  },
                  "bookingCategory": {
                    "type": "string",
                    "enum": [
                      "PROVISION",
                      "ROYALTY_ASSIGNED",
                      "ROYALTY_UNASSIGNED",
                      "UNDERACHIEVEMENT",
                      "ACCOUNTING_TYPE"
                    ],
                    "description": "Booking category of the credit note."
                  },
                  "currency": {
                    "type": "string",
                    "description": "ISO-4217 currency code used in the creditNote."
                  },
                  "sumNet": {
                    "type": "number",
                    "description": "Net sum of the creditNote."
                  },
                  "sumTax": {
                    "type": "number",
                    "description": "Tax sum of the creditNote."
                  },
                  "sumGross": {
                    "type": "number",
                    "description": "Gross sum of the creditNote."
                  },
                  "sumDiscounts": {
                    "type": "number",
                    "description": "Sum of all discounts in the creditNote."
                  },
                  "sumNetForeignCurrency": {
                    "type": "number",
                    "description": "Net sum in the foreign currency."
                  },
                  "sumTaxForeignCurrency": {
                    "type": "number",
                    "description": "Tax sum in the foreign currency."
                  },
                  "sumGrossForeignCurrency": {
                    "type": "number",
                    "description": "Gross sum in the foreign currency."
                  },
                  "sumDiscountsForeignCurrency": {
                    "type": "number",
                    "description": "Discounts sum in the foreign currency."
                  },
                  "customerInternalNote": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Internal note of the customer (field 'Referenz/Bestellnummer')."
