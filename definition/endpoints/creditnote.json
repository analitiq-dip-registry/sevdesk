                    "create": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Date of creditNote position creation. Declared as a plain string by the provider, e.g. '2023-04-18T15:45:38+02:00'."
                    },
                    "update": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Date of last creditNote position update. Declared as a plain string by the provider, e.g. '2023-04-18T15:45:38+02:00'."
                    },
                    "creditNote": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "The creditNote the position belongs to. Required when creating/updating a position on an existing credit note. Relation {id, objectName: 'CreditNote'}."
                    },
                    "part": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "Part from your inventory used in the position. Relation {id, objectName: 'Part'}."
                    },
                    "quantity": {
                      "type": "number",
                      "description": "Quantity of the article/part."
                    },
                    "price": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Price of the article/part. Gross or net depending on the sevdesk account setting."
                    },
                    "priceNet": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Net price of the part."
                    },
                    "priceTax": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Tax on the price of the part."
                    },
                    "priceGross": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Gross price of the part."
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Name of the article/part."
                    },
                    "unity": {
                      "type": "object",
                      "description": "The unit the position's part is measured in. Relation {id, objectName: 'Unity'}."
                    },
                    "sevClient": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "Client the position belongs to. Filled automatically. Relation {id, objectName: 'SevClient'}."
                    },
                    "positionNumber": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "Position number, used to order multiple positions."
                    },
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "A text describing the position."
                    },
                    "discount": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "An optional discount of the position."
                    },
                    "optional": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "Defines if the position is optional."
                    },
                    "taxRate": {
                      "type": "number",
                      "description": "Tax rate of the position."
                    },
                    "sumDiscount": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Discount sum of the position."
                    }
                  },
                  "required": [
                    "objectName",
                    "mapAll",
                    "quantity",
                    "unity",
                    "taxRate"
                  ]
                }
              },
              "creditNotePosDelete": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Credit note position to delete alongside the save. Relation {id, objectName: 'CreditNotePos'}."
              },
              "discountSave": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Discount or surcharge to create together with the credit note.",
                "properties": {
                  "discount": {
                    "type": "boolean",
                    "description": "Defines if this is a discount or a surcharge."
                  },
                  "text": {
                    "type": "string",
                    "description": "A text for the discount."
                  },
