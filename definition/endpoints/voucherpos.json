{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "voucherpos",
  "display_name": "Voucher Positions",
  "description": "Line items belonging to vouchers. Read-only: sevdesk exposes no POST on /VoucherPos and no /VoucherPos/{id} route; positions are created through /Voucher/Factory/saveVoucher.",
  "operations": {
    "read": {
      "params": {
        "voucher[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all voucher positions belonging to this voucher. Must be provided together with voucher[objectName]."
        },
        "voucher[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if voucher[id] was provided. Use 'Voucher'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/VoucherPos",
        "query": {
          "voucher[id]": {
            "from_param": "voucher[id]"
          },
          "voucher[objectName]": {
            "from_param": "voucher[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The voucher position id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The voucher position object name ('VoucherPos')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Date of voucher position creation. Carried as a string: the spec declares no format and its only example is the placeholder 01.01.2020, so no wire sample establishes a parseable timestamp or its zone."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Date of last voucher position update. Carried as a string: the spec declares no format and its only example is the placeholder 01.01.2020, so no wire sample establishes a parseable timestamp or its zone."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the voucher position belongs. sevdesk relation object; objectName is 'SevClient'."
                  },
                  "voucher": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The voucher to which the position belongs. sevdesk relation object; objectName is 'Voucher'."
                  },
                  "accountDatev": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The account datev (booking account) to which the position belongs. Used in sevdesk-Update 2.0, replacing accountingType. sevdesk relation object; objectName is 'AccountDatev'."
                  },
                  "accountingType": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The accounting type (booking account) to which the position belongs. sevdesk relation object; objectName is 'AccountingType'."
                  },
                  "estimatedAccountingType": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Accounting type estimated by sevdesk voucher recognition. sevdesk relation object; objectName is 'AccountingType'."
                  },
                  "taxRate": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax rate of the voucher position."
                  },
                  "net": {
                    "type": "boolean",
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Determines whether sumNet or sumGross is regarded."
                  },
                  "isAsset": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Determines whether the position is regarded as a depreciable asset."
                  },
                  "sumNet": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net sum of the voucher position."
                  },
                  "sumTax": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax sum of the voucher position."
                  },
                  "sumGross": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross sum of the voucher position."
                  },
                  "sumNetAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net accounting sum. Equal to sumNet."
                  },
                  "sumTaxAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax accounting sum. Equal to sumTax."
                  },
                  "sumGrossAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross accounting sum. Equal to sumGross."
                  },
                  "comment": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Comment for the voucher position."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    }
  }
}