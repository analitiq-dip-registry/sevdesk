{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "creditnotepos",
  "display_name": "Credit Note Positions",
  "description": "Line items belonging to credit notes, including quantity, pricing, tax rate and the referenced part.",
  "operations": {
    "read": {
      "params": {
        "creditNote[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Filter positions by credit note id (send together with creditNote[objectName])."
        },
        "creditNote[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Use 'CreditNote'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/CreditNotePos",
        "query": {
          "creditNote[id]": { "from_param": "creditNote[id]" },
          "creditNote[objectName]": { "from_param": "creditNote[objectName]" },
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "limit": {
          "param": "limit",
          "default": { "ref": "runtime.batch_size" },
          "max": 1000
        },
        "stop_when": {
          "empty": { "ref": "response.body.objects" }
        }
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "native_type": "string", "arrow_type": "Utf8", "description": "sevdesk id of the credit note position; returned as a JSON string." },
                  "objectName": { "type": "string", "native_type": "string", "arrow_type": "Utf8", "enum": ["CreditNotePos"] },
                  "create": { "type": "string", "format": "date-time", "native_type": "timestamp", "arrow_type": "Timestamp(MICROSECOND, UTC)", "description": "Creation timestamp (system-set)." },
                  "update": { "type": "string", "format": "date-time", "native_type": "timestamp", "arrow_type": "Timestamp(MICROSECOND, UTC)", "description": "Last-modification timestamp (system-set)." },
                  "creditNote": { "type": "object", "native_type": "object", "arrow_type": "Json", "description": "CreditNote relation ({id, objectName='CreditNote'})." },
                  "part": { "type": ["object", "null"], "native_type": "object", "arrow_type": "Json", "description": "Part relation ({id, objectName='Part'}); absent for free-text positions." },
                  "quantity": { "type": "string", "native_type": "string", "arrow_type": "Utf8", "description": "Quantity of the position; returned as a JSON string." },
                  "price": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Position price; returned as a JSON string." },
                  "priceNet": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Net price; returned as a JSON string." },
                  "priceTax": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Tax amount; returned as a JSON string." },
                  "priceGross": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Gross price; returned as a JSON string." },
                  "name": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Position name." },
                  "unity": { "type": "object", "native_type": "object", "arrow_type": "Json", "description": "Unity relation ({id, objectName='Unity'}) giving the unit of measure." },
                  "sevClient": { "type": "object", "native_type": "object", "arrow_type": "Json", "description": "SevClient relation ({id, objectName='SevClient'}); system-set." },
                  "positionNumber": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Ordering position within the credit note; returned as a JSON string." },
                  "text": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Free-text description of the position." },
                  "discount": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Discount on the position; returned as a JSON string." },
                  "optional": { "type": ["boolean", "null"], "native_type": "boolean", "arrow_type": "Boolean", "description": "Whether the position is optional." },
                  "taxRate": { "type": "string", "native_type": "string", "arrow_type": "Utf8", "description": "Tax rate of the position; returned as a JSON string." },
                  "sumDiscount": { "type": ["string", "null"], "native_type": "string", "arrow_type": "Utf8", "description": "Discount sum of the position; returned as a JSON string." }
                },
                "required": ["id", "objectName", "creditNote", "quantity", "unity", "taxRate"]
              }
            }
          }
        }
      }
    }
  }
}
