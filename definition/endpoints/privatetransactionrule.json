{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "privatetransactionrule",
  "display_name": "Private Transaction Rules",
  "description": "Rules that automatically mark matching bank transactions as private.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size. sevdesk accepts 1..1000 and returns HTTP 400 outside that range."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Record offset into the result set."
        }
      },
      "request": {
        "method": "GET",
        "path": "/PrivateTransactionRule",
        "query": {
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "description": "sevdesk wraps every list response in an `objects` array.",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The entity id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The entity object name, 'PrivateTransactionRule'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of entity creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last entity update. Not usable as a replication cursor: sevdesk documents no `updateAfter` filter on /PrivateTransactionRule."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the entity belongs, as a sevdesk relation ({ id, objectName: 'SevClient' })."
                  },
                  "paymentPurpose": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The payment purpose of transactions to match."
                  },
                  "counterpartName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The counterpart name of transactions to match."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/PrivateTransactionRule",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "description": "One private transaction rule to create. POST /PrivateTransactionRule takes the rule object bare (no envelope) and answers 201 with the created Model_PrivateTransactionRuleResponse, also bare. There is no upsert mode: /PrivateTransactionRule/{id} is DELETE-only, sevdesk documents no PUT.",
            "properties": {
              "objectName": {
                "type": "string",
                "description": "Must be 'PrivateTransactionRule'."
              },
              "paymentPurpose": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The purpose of transactions that you want to match."
              },
              "counterpartName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The counterpart name of transactions that you want to match."
              }
            },
            "required": [
              "objectName"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}