{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "privatetransactionrule",
  "display_name": "Private Transaction Rule",
  "description": "Rules that automatically classify private bank transactions by matching a payment purpose and/or a counterpart name. sevdesk documents exactly three operations for this resource — list, create and delete — so this endpoint exposes read (full refresh) and insert only.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/PrivateTransactionRule",
        "query": {
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "limit": {
          "param": "limit",
          "default": { "ref": "runtime.batch_size" },
          "max": 1000
        },
        "stop_when": {
          "empty": { "ref": "response.body.objects" }
        }
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Unique identifier of the rule (system-set). Declared type:string by the response model; numeric value serialized as a JSON string on the wire (spec example '1')."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": ["PrivateTransactionRule"],
                    "description": "Model name; always 'PrivateTransactionRule'."
                  },
                  "create": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Creation timestamp (system-set); wire samples carry a UTC offset (e.g. 2026-01-16T12:51:22+01:00)."
                  },
                  "update": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Last-modification timestamp (system-set); wire samples carry a UTC offset. Not usable as a replication cursor — sevdesk exposes no updateAfter/updateBefore filter on this operation."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client relation the rule belongs to ({id, objectName='SevClient'})."
                  },
                  "paymentPurpose": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The purpose of transactions that this rule matches. Matching is a case-sensitive simple string match."
                  },
                  "counterpartName": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The counterpart name of transactions that this rule matches. Matching is a case-sensitive simple string match."
                  }
                },
                "required": ["id", "objectName"]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/PrivateTransactionRule",
          "headers": { "Content-Type": "application/json" },
          "body": { "from_input": "record" }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "objectName": {
                "type": "string",
                "const": "PrivateTransactionRule",
                "description": "Model name; must be 'PrivateTransactionRule'."
              },
              "paymentPurpose": {
                "type": "string",
                "description": "The purpose of transactions that you want to match; case-sensitive simple string match. sevdesk requires at least one of paymentPurpose or counterpartName to be set, a constraint its request schema does not encode."
              },
              "counterpartName": {
                "type": "string",
                "description": "The counterpart name of transactions that you want to match; case-sensitive simple string match. sevdesk requires at least one of paymentPurpose or counterpartName to be set, a constraint its request schema does not encode."
              }
            },
            "required": ["objectName"]
          }
        },
        "response": {
          "generated_keys": { "ref": "response.body.id" }
        }
      }
    }
  }
}
