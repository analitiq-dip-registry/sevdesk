{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "display_name": "Private Transaction Rules",
  "description": "Rules auto-marking bank transactions as private.",
  "operations": {
    "read": {
      "request": {
        "method": "GET",
        "path": "/PrivateTransactionRule",
        "query": {
          "checkAccount[id]": {
            "from_param": "checkAccount[id]"
          },
          "checkAccount[objectName]": {
            "from_param": "checkAccount[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "params": {
        "checkAccount[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Filter by checkAccount[id]."
        },
        "checkAccount[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Use 'CheckAccount'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "create": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Create timestamp."
                  },
                  "update": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Last update timestamp."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "sevdesk client."
                  },
                  "checkAccount": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json"
                  },
                  "matchingType": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Matching rule kind."
                  },
                  "matchingValue": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "paymentPurpose": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The payment purpose of transactions to match."
                  },
                  "counterpartName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The counterpart name of transactions to match."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/PrivateTransactionRule",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "checkAccount": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "id",
                  "objectName"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "objectName": {
                    "type": "string",
                    "const": "CheckAccount"
                  }
                }
              },
              "matchingType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matchingValue": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
