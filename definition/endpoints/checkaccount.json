        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "pagination": {
        "type": "offset",
