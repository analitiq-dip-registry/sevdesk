{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "checkaccount",
  "display_name": "Check Accounts",
  "description": "Bank, cash, register and file-import accounts used for bookkeeping.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/CheckAccount",
        "query": {
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "description": "sevdesk wraps every read response in an `objects` array.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The check account id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The check account object name, always 'CheckAccount'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date of check account creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date of last check account update."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the check account belongs; filled automatically. sevdesk relation object shaped {id, objectName}, objectName = 'SevClient'."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the check account."
                  },
                  "iban": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The IBAN of the account."
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": [
                      "online",
                      "offline",
                      "register",
                      null
                    ],
                    "description": "The type of the check account. Accounts with a CSV or MT940 import are regarded as online."
                  },
                  "importType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": [
                      "CSV",
                      "MT940",
                      "None",
                      null
                    ],
                    "description": "Import type, for accounts that are type 'online' but not connected to a data provider."
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The currency of the check account."
                  },
                  "defaultAccount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines if this check account is the default account."
                  },
                  "baseAccount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "This will be 1 if the account is your base account that comes with every sevdesk setup."
                  },
                  "priority": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines the sorting of accounts, highest is first."
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": [
                      "0",
                      "100",
                      null
                    ],
                    "description": "Status of the check account. 0 <-> Archived, 100 <-> Active."
                  },
                  "balance": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The account balance as reported by PayPal or finAPI. Not set for other types of accounts."
                  },
                  "bankServer": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Bank server of the check account, only set if the account is connected to a data provider."
                  },
                  "autoMapTransactions": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines if transactions on this account are automatically mapped to invoices and vouchers when imported if possible."
                  },
                  "autoSyncTransactions": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "If this is 1 the account will be automatically updated through PayPal or finAPI. Only applicable for connected online accounts."
                  },
                  "lastSync": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Timepoint of the last payment import through PayPal or finAPI."
                  },
                  "accountingNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The booking account used for this account, e.g. 1800 in SKR04 and 1200 in SKR03. Must be unique among all your CheckAccounts."
                  },
                  "bic": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The BIC of the bank this account belongs to."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/CheckAccount/Factory/fileImportAccount",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the check account."
              },
              "importType": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "CSV",
                  "MT940",
                  null
                ],
                "description": "Import type. Transactions can be imported by this method on the check account."
              },
              "accountingNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The booking account used for this bank account, e.g. 1800 in SKR04 and 1200 in SKR03. Must be unique among all your CheckAccounts. Omit to use a sensible default."
              },
              "iban": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "IBAN of the bank account, without spaces."
              }
            }
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.objects.id"
          }
        }
      },
      "upsert": {
        "request": {
          "method": "PUT",
          "path": "/CheckAccount/{check_account_id}",
          "path_params": {
            "check_account_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The check account id; supplies the {checkAccountId} path segment and is the upsert conflict key."
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the check account."
              },
              "defaultAccount": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Defines if this check account is the default account. 0 <-> no, 1 <-> yes."
              },
              "autoMapTransactions": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Defines if transactions on this account are automatically mapped to invoices and vouchers when imported if possible."
              },
              "accountingNumber": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The booking account used for this bank account, e.g. 1800 in SKR04 and 1200 in SKR03. Must be unique among all your CheckAccounts."
              },
              "iban": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "IBAN of a bank account."
              },
              "bic": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "BIC of the related bank."
              }
            }
          }
        },
        "conflict_keys": [
          "id"
        ],
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}