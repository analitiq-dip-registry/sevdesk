                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "autoSyncTransactions": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "If 1, the account is automatically updated through PayPal or finAPI. Only for connected online accounts."
                  },
                  "lastSync": {
                    "type": "string",
                    "native_type": "datetime",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Timepoint of the last payment import through PayPal or finAPI."
                  },
                  "accountingNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "lastBalance": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "decimal",
                    "arrow_type": "Decimal128(18, 4)"
                  },
                  "balance": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "decimal",
                    "arrow_type": "Decimal128(18, 4)",
                    "description": "Account balance as reported by PayPal or finAPI. Not set for other account types."
                  }
                },
                "required": [
