                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "0=archived, 100=active."
                  },
                  "autoMapTransactions": {
                    "type": [
                      "string",
                      "null"
