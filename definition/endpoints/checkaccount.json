                    "arrow_type": "Utf8",
                    "description": "online | offline | register."
                  },
                  "importType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Import type for online accounts not connected to a data provider: CSV | MT940 | null."
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "defaultAccount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines if this check account is the default account."
                  },
                  "baseAccount": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "1 if the account is your base account that comes with every sevdesk setup."
                  },
                  "priority": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines the sorting of accounts; highest is first."
                  },
                  "iban": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8"
                  },
                  "bic": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
