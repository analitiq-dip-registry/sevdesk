                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Bank number of the bank used by the contact."
                  },
                  "defaultCashbackTime": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Absolute time in days within which the contact must pay invoices to get a cashback. Returned as a string even though it is written as an integer."
                  },
                  "defaultCashbackPercent": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Percentage of the invoice sum the contact gets back for invoices paid in time. Declared string/float on the response model; returned as a string."
                  },
                  "defaultTimeToPay": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The payment goal in days set on every invoice of the contact. Returned as a string even though it is written as an integer."
                  },
                  "taxNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The tax number of the contact."
                  },
                  "taxOffice": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The tax office of the contact (Greek customers only)."
                  },
                  "exemptVat": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Whether the contact is freed from paying VAT. Returned as the string 'true'/'false' even though it is written as a boolean."
                  },
                  "defaultDiscountAmount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The default discount the contact gets on every invoice — percentage or absolute value depending on defaultDiscountPercentage. Declared string/float on the response model."
                  },
                  "defaultDiscountPercentage": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Whether the discount is a percentage ('true') or an absolute value ('false'). Returned as a string even though it is written as a boolean."
                  },
                  "buyerReference": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Buyer reference of the contact."
                  },
                  "governmentAgency": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
