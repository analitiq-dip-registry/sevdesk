{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "contact",
  "display_name": "Contacts",
  "description": "sevdesk contacts — customers, suppliers, partners and prospects (organizations and persons).",
  "operations": {
    "read": {
      "params": {
        "depth": {
          "in": "query",
          "type": "string",
          "required": false,
          "default": {
            "literal": "1"
          },
          "description": "Defines whether both organizations and persons are returned. '0' -> only organizations, '1' -> organizations and persons. Defaults to '1' so the endpoint returns the full contact set; without it sevdesk returns organizations only."
        },
        "customerNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all contacts with this customer number."
        },
        "updateAfter": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "replication",
          "description": "Return only contacts modified after this point in time, as a Unix timestamp in seconds. Documented in the sevdesk API description's contact filter table."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size. sevdesk accepts 1..1000 and returns HTTP 400 outside that range."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Number of records to skip. sevdesk counts records, not pages."
        }
      },
      "request": {
        "method": "GET",
        "path": "/Contact",
        "query": {
          "depth": {
            "from_param": "depth"
          },
          "customerNumber": {
            "from_param": "customerNumber"
          },
          "updateAfter": {
            "from_param": "updateAfter"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "replication": {
        "supported_methods": [
          "full_refresh",
          "incremental"
        ],
        "cursor_mappings": [
          {
            "cursor_field": "update",
            "param": "updateAfter",
            "operator": "gt",
            "format": "epoch_seconds"
          }
        ]
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "description": "The sevdesk list envelope — every read response wraps its records in 'objects'.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The contact id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The contact object name — always 'Contact'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of contact creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last contact update. Backs incremental replication via the updateAfter filter."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The organization name. The contact is regarded as an organization when this holds a value."
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Status of the contact: 100 = Lead, 500 = Pending, 1000 = Active. Returned as a string even though it is written as an integer."
                  },
                  "customerNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The customer number."
                  },
                  "parent": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The parent contact to which this contact belongs; must be an organization. sevdesk relation of shape {id, objectName} with objectName 'Contact'."
                  },
                  "surename": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The first name of the contact (sevdesk spells it 'surename'). Not used for organizations."
                  },
                  "familyname": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The last name of the contact. Not used for organizations."
                  },
                  "titel": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "A non-academic title for the contact. Not used for organizations."
                  },
                  "category": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Category of the contact. sevdesk relation of shape {id, objectName} with objectName 'Category'."
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
