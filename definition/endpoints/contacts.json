          "depth": {
            "from_param": "depth"
          },
          "customerNumber": {
            "from_param": "customer_number"
          },
          "country[id]": {
            "from_param": "country_id"
          },
          "country[objectName]": {
            "from_param": "country_object_name"
          },
          "category[id]": {
            "from_param": "category_id"
          },
          "category[objectName]": {
            "from_param": "category_object_name"
          },
          "embed": {
            "from_param": "embed"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "params": {
        "depth": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Include nested resources (0 or 1)."
        },
        "customer_number": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Filter contacts by customer number."
        },
        "country_id": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Country id filter (use with country_object_name)."
        },
        "country_object_name": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Object name of the country relation. Use 'StaticCountry'."
        },
        "category_id": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Category id filter (use with category_object_name)."
        },
        "category_object_name": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Object name of the category relation. Use 'Category'."
        },
        "embed": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Comma-separated list of nested resources to embed."
