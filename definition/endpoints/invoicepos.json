{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "invoicepos",
  "display_name": "Invoice Positions",
  "description": "Line items belonging to invoices. Read-only: sevdesk exposes no POST on /InvoicePos and no /InvoicePos/{id} route; positions are created through /Invoice/Factory/saveInvoice.",
  "operations": {
    "read": {
      "params": {
        "id": {
          "in": "query",
          "type": "number",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all InvoicePos with this InvoicePos id."
        },
        "invoice[id]": {
          "in": "query",
          "type": "number",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all invoice positions belonging to this invoice. Must be provided together with invoice[objectName]."
        },
        "invoice[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if invoice[id] was provided. Use 'Invoice'."
        },
        "part[id]": {
          "in": "query",
          "type": "number",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all invoice positions using this part. Must be provided together with part[objectName]."
        },
        "part[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if part[id] was provided. Use 'Part'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/InvoicePos",
        "query": {
          "id": {
            "from_param": "id"
          },
          "invoice[id]": {
            "from_param": "invoice[id]"
          },
          "invoice[objectName]": {
            "from_param": "invoice[objectName]"
          },
          "part[id]": {
            "from_param": "part[id]"
          },
          "part[objectName]": {
            "from_param": "part[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The invoice position id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The invoice position object name ('InvoicePos')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of invoice position creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last invoice position update."
                  },
                  "invoice": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The invoice to which the position belongs. sevdesk relation object; objectName is 'Invoice'."
                  },
                  "part": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Part from your inventory which is used in the position. sevdesk relation object; objectName is 'Part'."
                  },
                  "quantity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Quantity of the article/part. NOTE: the OpenAPI spec declares Model_InvoicePosResponse.quantity as type boolean (example true); that is a spec defect. Authored as a numeric string, matching every sibling position response model and the numeric write model."
                  },
                  "price": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Price of the article/part. Gross or net depending on the sevdesk account setting."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the article/part."
                  },
                  "unity": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The unit in which the position's part is measured. sevdesk relation object; objectName is 'Unity'."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the invoice position belongs. sevdesk relation object; objectName is 'SevClient'."
                  },
                  "positionNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position number, usable to order multiple positions."
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "A text describing the position."
                  },
                  "discount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "An optional discount of the position."
                  },
                  "taxRate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax rate of the position."
                  },
                  "sumDiscount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount sum of the position."
                  },
                  "sumNetAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net accounting sum of the position."
                  },
                  "sumTaxAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax accounting sum of the position."
                  },
                  "sumGrossAccounting": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross accounting sum of the position."
                  },
                  "priceNet": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net price of the part."
                  },
                  "priceGross": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross price of the part."
                  },
                  "priceTax": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax on the price of the part."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    }
  }
}