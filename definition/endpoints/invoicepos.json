{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "invoicepos",
  "display_name": "Invoice Positions",
  "description": "Line items (positions) belonging to invoices, including quantity, unit price, tax rate and computed net/gross accounting sums.",
  "operations": {
    "read": {
      "params": {
        "id": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Filter by invoice position id."
        },
        "invoice[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Filter by the id of the invoice the position belongs to (send together with invoice[objectName])."
        },
        "invoice[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Use 'Invoice'."
        },
        "part[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Filter by the id of the part referenced by the position (send together with part[objectName])."
        },
        "part[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Use 'Part'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/InvoicePos",
        "query": {
          "id": { "from_param": "id" },
          "invoice[id]": { "from_param": "invoice[id]" },
          "invoice[objectName]": { "from_param": "invoice[objectName]" },
          "part[id]": { "from_param": "part[id]" },
          "part[objectName]": { "from_param": "part[objectName]" },
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "limit": {
          "param": "limit",
          "default": { "ref": "runtime.batch_size" },
          "max": 1000
        },
        "stop_when": {
          "empty": { "ref": "response.body.objects" }
        }
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "sevdesk id of the invoice position; serialized as a string on the read path."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": ["InvoicePos"]
                  },
                  "create": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Creation timestamp (system-set)."
                  },
                  "update": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Last-modification timestamp (system-set)."
                  },
                  "invoice": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Invoice relation ({id, objectName='Invoice'})."
                  },
                  "part": {
                    "type": ["object", "null"],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Part relation ({id, objectName='Part'}); absent for free-text positions."
                  },
                  "quantity": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Quantity of the position. Wire-serialized as a string like every other numeric on this response model. Model_InvoicePosResponse declares type:boolean/example:true, which is an unbacked generator artefact contradicted by both Model_InvoicePos (number/float) and the tag attribute table (Double); see the notes on this endpoint."
                  },
                  "price": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Unit price of the position; wire-serialized as a string."
                  },
                  "name": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the position."
                  },
                  "unity": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Unity relation ({id, objectName='Unity'}) — the unit the quantity is measured in."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "SevClient relation ({id, objectName='SevClient'}) — the owning client; system-set."
                  },
                  "positionNumber": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Ordering position of the line item within the invoice; wire-serialized as a string."
                  },
                  "text": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Free-text description of the position."
                  },
                  "discount": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount applied to the position; wire-serialized as a string."
                  },
                  "taxRate": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax rate of the position in percent; wire-serialized as a string."
                  },
                  "sumDiscount": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount sum of the position; wire-serialized as a string."
                  },
                  "sumNetAccounting": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net accounting sum of the position; wire-serialized as a string."
                  },
                  "sumTaxAccounting": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax accounting sum of the position; wire-serialized as a string."
                  },
                  "sumGrossAccounting": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross accounting sum of the position; wire-serialized as a string."
                  },
                  "priceNet": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net price of the position; wire-serialized as a string."
                  },
                  "priceGross": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross price of the position; wire-serialized as a string."
                  },
                  "priceTax": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax amount of the position; wire-serialized as a string."
                  }
                },
                "required": ["id", "objectName"]
              }
            }
          }
        }
      }
    }
  }
}
