{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "accountingcontact",
  "display_name": "Accounting Contacts",
  "description": "Accounting-specific debitor/creditor numbers per contact.",
  "operations": {
    "read": {
      "params": {
        "contact[id]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "ID of the contact for which you want the accounting contact."
        },
        "contact[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Object name. Only needed if you also defined the ID of a contact; use 'Contact'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/AccountingContact",
        "query": {
          "contact[id]": {
            "from_param": "contact[id]"
          },
          "contact[objectName]": {
            "from_param": "contact[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The accounting contact id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The accounting contact object name ('AccountingContact')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of accounting contact creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last accounting contact update."
                  },
                  "contact": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The contact to which this accounting contact belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"Contact\"}."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the accounting contact belongs. sevdesk relation of the form {\"id\": ..., \"objectName\": \"SevClient\"}; filled automatically."
                  },
                  "debitorNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Debitor number of the accounting contact."
                  },
                  "creditorNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Creditor number of the accounting contact."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/AccountingContact",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "contact": {
                "type": "object",
                "description": "The contact to which this accounting contact belongs. sevdesk relation: {\"id\": <contact id>, \"objectName\": \"Contact\"}."
              },
              "debitorNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Debitor number of the accounting contact. sevdesk declares this integer on the request body while the response returns it as a string."
              },
              "creditorNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Creditor number of the accounting contact. sevdesk declares this integer on the request body while the response returns it as a string."
              }
            },
            "required": [
              "contact"
            ]
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      },
      "upsert": {
        "request": {
          "method": "PUT",
          "path": "/AccountingContact/{accounting_contact_id}",
          "path_params": {
            "accounting_contact_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The accounting contact id; supplies the {accountingContactId} path segment."
              },
              "contact": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The contact to which this accounting contact belongs. sevdesk relation: {\"id\": <contact id>, \"objectName\": \"Contact\"}."
              },
              "debitorNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Debitor number of the accounting contact."
              },
              "creditorNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Creditor number of the accounting contact."
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "conflict_keys": [
          "id"
        ],
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}