                ],
                "description": "Client to which the check account transaction belongs; filled automatically. sevdesk relation object shaped {id, objectName}, objectName = 'SevClient'."
              },
              "valueDate": {
                "type": "string",
                "format": "date-time",
                "description": "Date the check account transaction was booked."
              },
              "entryDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date the check account transaction was imported."
              },
              "paymtPurpose": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The purpose of the transaction."
              },
              "amount": {
                "type": "number",
                "description": "Amount of the transaction."
              },
              "payeePayerName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the other party. Required by the provider, though the field itself is nullable."
              },
              "payeePayerAcctNo": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "IBAN or account number of the other party."
              },
              "payeePayerBankCode": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "BIC or bank code of the other party."
              },
              "checkAccount": {
                "type": "object",
                "description": "The check account to which the transaction belongs. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccount'."
              },
              "status": {
                "type": "integer",
                "description": "Status of the check account transaction. 100 <-> Created, 200 <-> Linked, 300 <-> Private, 400 <-> Booked."
              },
              "sourceTransaction": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The check account transaction serving as the source of the rebooking. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccountTransaction'."
              },
              "targetTransaction": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The check account transaction serving as the target of the rebooking. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccountTransaction'."
              }
            }
          }
        },
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      },
      "upsert": {
