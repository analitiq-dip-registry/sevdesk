          "path": "/CheckAccountTransaction/{check_account_transaction_id}",
          "path_params": {
            "check_account_transaction_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The check account transaction id; supplies the {checkAccountTransactionId} path segment and is the upsert conflict key."
              },
              "valueDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date the check account transaction was booked."
              },
              "entryDate": {
                "type": [
