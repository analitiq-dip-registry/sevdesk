{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "checkaccounttransaction",
  "display_name": "Check Account Transactions",
  "description": "Bank, cash and register transactions booked on sevdesk payment accounts.",
  "operations": {
    "read": {
      "params": {
        "checkAccount[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all transactions on this check account. Must be provided together with checkAccount[objectName]."
        },
        "checkAccount[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if checkAccount[id] was provided. Use 'CheckAccount' as the value."
        },
        "isBooked": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only retrieve booked transactions."
        },
        "paymtPurpose": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only retrieve transactions with this payment purpose."
        },
        "startDate": {
          "in": "query",
          "type": "string",
          "format": "date-time",
          "required": false,
          "operators": [
            "gte"
          ],
          "description": "Only retrieve transactions from this date on. Windows valueDate (the transaction's document date), not modification time."
        },
        "endDate": {
          "in": "query",
          "type": "string",
          "format": "date-time",
          "required": false,
          "operators": [
            "lte"
          ],
          "description": "Only retrieve transactions up to this date. Windows valueDate (the transaction's document date), not modification time."
        },
        "payeePayerName": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only retrieve transactions with this payee / payer."
        },
        "onlyCredit": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only retrieve credit transactions."
        },
        "onlyDebit": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only retrieve debit transactions."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/CheckAccountTransaction",
        "query": {
          "checkAccount[id]": {
            "from_param": "checkAccount[id]"
          },
          "checkAccount[objectName]": {
            "from_param": "checkAccount[objectName]"
          },
          "isBooked": {
            "from_param": "isBooked"
          },
          "paymtPurpose": {
            "from_param": "paymtPurpose"
          },
          "startDate": {
            "from_param": "startDate"
          },
          "endDate": {
            "from_param": "endDate"
          },
          "payeePayerName": {
            "from_param": "payeePayerName"
          },
          "onlyCredit": {
            "from_param": "onlyCredit"
          },
          "onlyDebit": {
            "from_param": "onlyDebit"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "description": "sevdesk wraps every read response in an `objects` array.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The check account transaction id."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The check account transaction object name, always 'CheckAccountTransaction'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date of check account transaction creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date of last check account transaction update."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the check account transaction belongs; filled automatically. sevdesk relation object shaped {id, objectName}, objectName = 'SevClient'."
                  },
                  "valueDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date the check account transaction was imported."
                  },
                  "entryDate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Date the check account transaction was booked."
                  },
                  "paymtPurpose": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The purpose of the transaction."
                  },
                  "amount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Amount of the transaction, delivered as a decimal string (e.g. '-100.32')."
                  },
                  "payeePayerName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the other party."
                  },
                  "payeePayerAcctNo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "IBAN or account number of the other party."
                  },
                  "payeePayerBankCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "BIC or bank code of the other party."
                  },
                  "gvCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "ZKA business transaction code. This can be given for finAPI accounts."
                  },
                  "entryText": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Transaction type, according to the bank. This can be given for finAPI accounts."
                  },
                  "primaNotaNo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Transaction primanota. This can be given for finAPI accounts."
                  },
                  "checkAccount": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The check account to which the transaction belongs. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccount'."
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": [
                      "100",
                      "200",
                      "300",
                      "350",
                      "400",
                      null
                    ],
                    "description": "Status of the check account transaction. 100 <-> Created, 200 <-> Linked, 300 <-> Private, 350 <-> Auto-booked without user confirmation, 400 <-> Booked."
                  },
                  "sourceTransaction": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The check account transaction serving as the source of a money transit. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccountTransaction'."
                  },
                  "targetTransaction": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The check account transaction serving as the target of a money transit. sevdesk relation object shaped {id, objectName}, objectName = 'CheckAccountTransaction'."
                  },
                  "enshrined": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "format": "date-time",
                    "description": "Timepoint when the transaction was enshrined."
                  }
                }
              }
            }
          }
        }
      }
    },
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/CheckAccountTransaction",
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "type": "object",
            "required": [
