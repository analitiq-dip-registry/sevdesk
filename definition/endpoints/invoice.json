{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "invoice",
  "display_name": "Invoices",
  "description": "Outbound invoices including drafts, open, partially paid, paid and cancelled documents.",
  "operations": {
    "read": {
      "params": {
        "status": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Filter by invoice status (100 = draft, 200 = open, 1000 = paid)."
        },
        "invoiceNumber": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all invoices with this invoice number."
        },
        "startDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "gte"
          ],
          "description": "Retrieve all invoices with an invoice date equal or higher, as epoch seconds."
        },
        "endDate": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "lte"
          ],
          "description": "Retrieve all invoices with an invoice date equal or lower, as epoch seconds."
        },
        "contact[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all invoices of this contact. Must be sent together with contact[objectName]."
        },
        "contact[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if contact[id] was provided. 'Contact' should be used as value."
        },
        "updateAfter": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "replication",
          "description": "Retrieve only invoices modified after this timestamp, as epoch seconds."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Number of records per page (1-1000)."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Number of records to skip."
        }
      },
      "request": {
        "method": "GET",
        "path": "/Invoice",
        "query": {
          "status": {
            "from_param": "status"
          },
          "invoiceNumber": {
            "from_param": "invoiceNumber"
          },
          "startDate": {
            "from_param": "startDate"
          },
          "endDate": {
            "from_param": "endDate"
          },
          "contact[id]": {
            "from_param": "contact[id]"
          },
          "contact[objectName]": {
            "from_param": "contact[objectName]"
          },
          "updateAfter": {
            "from_param": "updateAfter"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "replication": {
        "supported_methods": [
          "full_refresh",
          "incremental"
        ],
        "cursor_mappings": [
          {
            "cursor_field": "update",
            "param": "updateAfter",
            "operator": "gt",
            "format": "epoch_seconds"
          }
        ]
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
