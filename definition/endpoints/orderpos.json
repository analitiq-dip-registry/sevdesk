{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "orderpos",
  "display_name": "Order Positions",
  "description": "Line items belonging to orders. Readable and updatable; sevdesk exposes no POST on /OrderPos, so creation happens through /Order/Factory/saveOrder.",
  "operations": {
    "read": {
      "params": {
        "order[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Retrieve all order positions belonging to this order. Must be provided together with order[objectName]."
        },
        "order[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": [
            "eq"
          ],
          "description": "Only required if order[id] was provided. Use 'Order'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/OrderPos",
        "query": {
          "order[id]": {
            "from_param": "order[id]"
          },
          "order[objectName]": {
            "from_param": "order[objectName]"
          },
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The order position id."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The order position object name ('OrderPos')."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of order position creation."
                  },
                  "update": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date of last order position update."
                  },
                  "order": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The order to which the position belongs. sevdesk relation object; objectName is 'Order'."
                  },
                  "part": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Part from your inventory which is used in the position. sevdesk relation object; objectName is 'Part'."
                  },
                  "quantity": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Quantity of the article/part."
                  },
                  "price": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Price of the article/part. Gross or net depending on the sevdesk account setting."
                  },
                  "priceNet": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net price of the part."
                  },
                  "priceTax": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax on the price of the part."
                  },
                  "priceGross": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross price of the part."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Name of the article/part."
                  },
                  "unity": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "The unit in which the position's part is measured. sevdesk relation object; objectName is 'Unity'."
                  },
                  "sevClient": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client to which the order position belongs. sevdesk relation object; objectName is 'SevClient'."
                  },
                  "positionNumber": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position number, usable to order multiple positions."
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "A text describing the position."
                  },
                  "discount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "An optional discount of the position."
                  },
                  "optional": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Defines if the position is optional. sevdesk returns this as the string '0'/'1' on the read path even though its OpenAPI model declares type: boolean — the spec's own example for this field is a quoted string. Typed Utf8 so the value survives; the write path still takes a real boolean."
                  },
                  "taxRate": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax rate of the position."
                  },
                  "sumDiscount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount sum of the position."
                  }
                },
                "required": [
                  "id",
                  "objectName"
                ]
              }
            }
          }
        }
      }
    },
    "write": {
      "upsert": {
        "request": {
          "method": "PUT",
          "path": "/OrderPos/{order_pos_id}",
          "path_params": {
            "order_pos_id": {
              "from_input": "record.id"
            }
          },
          "body": {
            "from_input": "record"
          }
        },
        "input": {
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "The order position id. Supplies the {orderPosId} path segment."
              },
              "objectName": {
                "type": "string",
                "description": "The order position object name ('OrderPos')."
              },
              "create": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of order position creation."
              },
              "update": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Date of last order position update."
              },
              "order": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The order to which the position belongs. sevdesk relation object of the form {id, objectName}; objectName must be 'Order'."
              },
              "part": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Part from your inventory which is used in the position. sevdesk relation object of the form {id, objectName}; objectName must be 'Part'."
              },
              "quantity": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Quantity of the article/part."
              },
              "price": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Price of the article/part. Gross or net depending on the sevdesk account setting."
              },
              "priceNet": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Net price of the part."
              },
              "priceTax": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Tax on the price of the part."
              },
              "priceGross": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Gross price of the part."
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the article/part."
              },
              "unity": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The unit in which the position's part is measured. sevdesk relation object of the form {id, objectName}; objectName must be 'Unity'."
              },
              "sevClient": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Client to which the order position belongs. sevdesk relation object of the form {id, objectName}; objectName must be 'SevClient'. Filled automatically."
              },
              "positionNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Position number, usable to order multiple positions."
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A text describing the position."
              },
              "discount": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "An optional discount of the position."
              },
              "optional": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Defines if the position is optional."
              },
              "taxRate": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Tax rate of the position."
              },
              "sumDiscount": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Discount sum of the position."
              }
            }
          }
        },
        "conflict_keys": [
          "id"
        ],
        "response": {
          "generated_keys": {
            "ref": "response.body.id"
          }
        }
      }
    }
  }
}
