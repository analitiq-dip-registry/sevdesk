{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "orderpos",
  "display_name": "Order positions",
  "description": "Line-item positions belonging to orders, including quantity, pricing, tax rate, and relations to the parent order, part, and unit.",
  "operations": {
    "read": {
      "params": {
        "order[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Filter positions by parent order id (send together with order[objectName])."
        },
        "order[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Use 'Order'."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination"
        }
      },
      "request": {
        "method": "GET",
        "path": "/OrderPos",
        "query": {
          "order[id]": { "from_param": "order[id]" },
          "order[objectName]": { "from_param": "order[objectName]" },
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": { "ref": "response.record_count" }
        },
        "limit": {
          "param": "limit",
          "default": { "ref": "runtime.batch_size" },
          "max": 1000
        },
        "stop_when": {
          "empty": { "ref": "response.body.objects" }
        }
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Numeric id, serialized as a JSON string on the wire (system-set)."
                  },
                  "objectName": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": ["OrderPos"]
                  },
                  "create": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Creation timestamp (system-set)."
                  },
                  "update": {
                    "type": "string",
                    "format": "date-time",
                    "native_type": "timestamp",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Last-modification timestamp (system-set)."
                  },
                  "order": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Parent order relation ({id, objectName='Order'})."
                  },
                  "part": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Part relation ({id, objectName='Part'})."
                  },
                  "quantity": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Quantity; numeric value serialized as a JSON string on the wire."
                  },
                  "price": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position price; numeric value serialized as a JSON string on the wire."
                  },
                  "priceNet": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Net price (system-computed); numeric value serialized as a JSON string on the wire."
                  },
                  "priceTax": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax amount; numeric value serialized as a JSON string on the wire."
                  },
                  "priceGross": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Gross price; numeric value serialized as a JSON string on the wire."
                  },
                  "name": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position name."
                  },
                  "unity": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Unit relation ({id, objectName='Unity'})."
                  },
                  "sevClient": {
                    "type": "object",
                    "native_type": "object",
                    "arrow_type": "Json",
                    "description": "Client relation (system-set; {id, objectName='SevClient'})."
                  },
                  "positionNumber": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position order number; numeric value serialized as a JSON string on the wire."
                  },
                  "text": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Position description text."
                  },
                  "discount": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount; numeric value serialized as a JSON string on the wire."
                  },
                  "optional": {
                    "type": ["boolean", "null"],
                    "native_type": "boolean",
                    "arrow_type": "Boolean",
                    "description": "Whether the position is marked optional."
                  },
                  "taxRate": {
                    "type": "string",
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Tax rate; numeric value serialized as a JSON string on the wire."
                  },
                  "sumDiscount": {
                    "type": ["string", "null"],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Discount sum (system-computed); numeric value serialized as a JSON string on the wire."
                  }
                },
                "required": ["id", "objectName"]
              }
            }
          }
        }
      }
    },
    "write": {
      "upsert": {
        "conflict_keys": ["id"],
        "request": {
          "method": "PUT",
          "path": "/OrderPos/{order_pos_id}",
          "headers": { "Content-Type": "application/json" },
          "path_params": {
            "order_pos_id": { "from_input": "record.id" }
          },
          "body": { "from_input": "record" }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "sevdesk id of the order position to update; supplies the {orderPosId} path segment. Numeric value, serialized as a string on the read side. PUT /OrderPos/{orderPosId} updates only - an unknown id is a 404, not a create."
              },
              "order": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Order" }
                },
                "description": "Parent order relation."
              },
              "part": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Part" }
                },
                "description": "Part relation."
              },
              "quantity": {
                "type": "string",
                "description": "Quantity; numeric value, accepted as its wire-serialized string form."
              },
              "price": {
                "type": "string",
                "description": "Position price; numeric value, accepted as its wire-serialized string form."
              },
              "priceTax": {
                "type": "string",
                "description": "Tax amount; numeric value, accepted as its wire-serialized string form."
              },
              "priceGross": {
                "type": "string",
                "description": "Gross price; numeric value, accepted as its wire-serialized string form."
              },
              "name": {
                "type": "string",
                "description": "Position name."
              },
              "unity": {
                "type": "object",
                "required": ["id", "objectName"],
                "properties": {
                  "id": { "type": "integer" },
                  "objectName": { "type": "string", "const": "Unity" }
                },
                "description": "Unit relation."
              },
              "positionNumber": {
                "type": "string",
                "description": "Position order number; numeric value, accepted as its wire-serialized string form."
              },
              "text": {
                "type": "string",
                "description": "Position description text."
              },
              "discount": {
                "type": "string",
                "description": "Discount; numeric value, accepted as its wire-serialized string form."
              },
              "optional": {
                "type": "boolean",
                "description": "Whether the position is marked optional."
              },
              "taxRate": {
                "type": "string",
                "description": "Tax rate; numeric value, accepted as its wire-serialized string form."
              }
            },
            "required": ["id"]
          }
        }
      }
    }
  }
}
