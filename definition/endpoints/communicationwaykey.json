{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "communicationwaykey",
  "display_name": "Communication Way Keys",
  "description": "Reference data: the fixed set of communication-way keys (Privat, Arbeit, Fax, Mobil, ...) a contact's communication way can carry. Read-only.",
  "operations": {
    "read": {
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size. sevdesk accepts 1..1000 and returns HTTP 400 outside that range."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Record offset into the result set."
        }
      },
      "request": {
        "method": "GET",
        "path": "/CommunicationWayKey",
        "query": {
          "limit": {
            "from_param": "limit"
          },
          "offset": {
            "from_param": "offset"
          }
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "default": {
            "ref": "runtime.batch_size"
          },
          "max": 1000
        },
        "stop_when": {
          "empty": {
            "ref": "response.body.objects"
          }
        }
      },
      "response": {
        "records": {
          "ref": "response.body.objects"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "description": "sevdesk wraps every list response in an `objects` array.",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "Item shape is declared INLINE on GET /CommunicationWayKey; sevdesk publishes no component model for it.",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "The id of the communication way key. 1 = Privat, 2 = Arbeit, 3 = Fax, 4 = Mobil, 5 = ' ', 6 = Autobox, 7 = Newsletter, 8 = Rechnungsadresse."
                  },
                  "objectName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Object name, which is 'CommunicationWayKey'."
                  },
                  "create": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date the communication way key was created."
                  },
                  "upadate": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "native_type": "date-time",
                    "arrow_type": "Timestamp(MICROSECOND, UTC)",
                    "description": "Date the communication way key was last updated. The field name is MISSPELLED 'upadate' by sevdesk; this is the wire name the provider actually sends, so it is authored verbatim rather than corrected. Not usable as a replication cursor: sevdesk documents no filter param for it."
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "enum": [
                      "Arbeit",
                      "Autobox",
                      "Fax",
                      "Mobil",
                      "Newsletter",
                      "Privat",
                      "Rechnungsadresse",
                      " ",
                      null
                    ],
                    "description": "Name of the communication way key. Closed domain of 8 values; one member is a single space (' ', key id 5). `null` is admitted because the field is nullable."
                  },
                  "translationCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "native_type": "string",
                    "arrow_type": "Utf8",
                    "description": "Translation code of the communication way key, e.g. 'COMM_WAY_KEY_WORK'."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}