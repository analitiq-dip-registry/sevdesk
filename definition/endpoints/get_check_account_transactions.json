{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "get_check_account_transactions",
  "display_name": "Get Check Account Transactions",
  "description": "Retrieve check account transactions (bank payments) from sevdesk.",
  "operations": {
    "read": {
      "request": {
        "path": "/CheckAccountTransaction",
        "method": "GET"
      },
      "response": {
        "records": { "ref": "response.body.objects" },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "CheckAccountTransactionList",
          "description": "sevdesk list response for CheckAccountTransaction.",
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "description": "The check account transaction id" },
                  "objectName": { "type": "string", "description": "The check account transaction object name" },
                  "create": { "type": "string", "format": "date-time", "description": "Date of check account transaction creation" },
                  "update": { "type": "string", "format": "date-time", "description": "Date of last check account transaction update" },
                  "sevClient": {
                    "type": "object",
                    "description": "Client to which check account transaction belongs",
                    "properties": {
                      "id": { "type": "string" },
                      "objectName": { "type": "string" }
                    }
                  },
                  "valueDate": { "type": "string", "format": "date-time" },
                  "entryDate": { "type": ["string", "null"], "format": "date-time" },
                  "paymtPurpose": { "type": ["string", "null"] },
                  "amount": { "type": "string" },
                  "payeePayerName": { "type": ["string", "null"] },
                  "payeePayerAcctNo": { "type": ["string", "null"] },
                  "payeePayerBankCode": { "type": ["string", "null"] },
                  "gvCode": { "type": ["string", "null"] },
                  "entryText": { "type": ["string", "null"] },
                  "primaNotaNo": { "type": ["string", "null"] },
                  "checkAccount": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "objectName": { "type": "string" }
                    }
                  },
                  "status": { "type": "string" },
                  "sourceTransaction": {
                    "type": ["object", "null"],
                    "properties": {
                      "id": { "type": "string" },
                      "objectName": { "type": "string" }
                    }
                  },
                  "targetTransaction": {
                    "type": ["object", "null"],
                    "properties": {
                      "id": { "type": "string" },
                      "objectName": { "type": "string" }
                    }
                  },
                  "enshrined": { "type": ["string", "null"], "format": "date-time" }
                }
              }
            }
          }
        }
      },
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Offset/start index."
        },
        "checkAccount[id]": {
          "in": "query",
          "type": "integer",
          "required": false,
          "operators": ["eq"],
          "description": "Retrieve all transactions on this check account. Must be provided with checkAccount[objectName]."
        },
        "checkAccount[objectName]": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Only required if checkAccount[id] was provided. 'CheckAccount' should be used as value."
        },
        "isBooked": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": ["eq"],
          "description": "Only retrieve booked transactions."
        },
        "paymtPurpose": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Only retrieve transactions with this payment purpose."
        },
        "startDate": {
          "in": "query",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "Only retrieve transactions from this date on."
        },
        "endDate": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["lte"],
          "description": "Only retrieve transactions up to this date."
        },
        "payeePayerName": {
          "in": "query",
          "type": "string",
          "required": false,
          "operators": ["eq"],
          "description": "Only retrieve transactions with this payee/payer."
        },
        "onlyCredit": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": ["eq"],
          "description": "Only retrieve credit transactions."
        },
        "onlyDebit": {
          "in": "query",
          "type": "boolean",
          "required": false,
          "operators": ["eq"],
          "description": "Only retrieve debit transactions."
        }
      },
      "pagination": {
        "type": "offset",
        "offset": { "param": "offset", "initial": 0 },
        "limit": { "param": "limit", "max": 1000, "default": 1000 },
        "stop_when": { "empty": { "ref": "response.body.objects" } }
      },
      "replication": {
        "supported_methods": ["full_refresh", "incremental"],
        "cursor_mappings": [
          {
            "cursor_field": "update",
            "param": "startDate",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      }
    }
  }
}
